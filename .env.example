# Bella .env.example — şema rehberi (gerçek değerler Bitwarden'da)
#
# Yeni dev kurulumunda: bu dosyayı `.env.local` adıyla kopyala + Bitwarden'dan
# (`GunesAI / Bella — .env.local Production` Secure Note) değerleri doldur.
# Yeni tenant onboarding: `multi-tenant-onboarding-yol-a.md` §8.1 örnek bloğunu
# tenant'a özel değerlerle doldur, Bitwarden'da ayrı Secure Note olarak sakla.
#
# Detay: vault/operasyon/SOPs/bitwarden-secrets-transfer.md §10 (20 secret risk haritası)
# Son güncelleme: 2026-05-17 (BD-INFRA-MT-SYNC turu — 20 env)

# === Multi-Tenant ===
# Tenant slug seçici (config/client.ts wrapper). Env yokken default 'bella' fallback.
# NEXT_PUBLIC_ prefix client bundle build-time inline için zorunlu (6 client component CLIENT_CONFIG import ediyor).
NEXT_PUBLIC_CLIENT_ID=bella

# === Anthropic ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Airtable ===
AIRTABLE_API_KEY=your_airtable_pat_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_NAME=Randevular
# Default'lu override'lar (lib/staff.ts + lib/customer-notes.ts) — nadiren değiştirilir
AIRTABLE_STAFF_TABLE=Staff
AIRTABLE_NOTES_TABLE=CustomerNotes

# === Google Calendar ===
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_CALENDAR_ID=primary

# === Clerk ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# === Twilio SMS ===
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# === Cron ===
# Rastgele üret: openssl rand -hex 32
CRON_SECRET=your_random_cron_secret_here
